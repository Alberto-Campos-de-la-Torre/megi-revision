# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# MEGI Revisión
MEGI_MODE=mock            # mock | http
MEGI_URL=http://127.0.0.1:8020
MEGI_USER=demo_medico
MEGI_PASSWORD=
# Correos (separados por comas) con rol clínico: pueden leer expedientes y firmar con la cuenta de servicio.
# Obligatorio en MEGI_MODE=http (sin lista, el acceso falla cerrado). Opcional en mock.
# MEGI_MEDICOS=medico@ejemplo.test
# Identidad individual (preferida): cada médico guarda su propio usuario y contraseña de MEGI en
# Ajustes → claves (MEGI_USUARIO / MEGI_CONTRASENA, ámbito usuario, cifradas en servidor). Con ella la app
# lee solo sus pacientes y MEGI firma con su identidad; MEGI_USER/MEGI_PASSWORD quedan como cuenta de
# servicio de respaldo, solo para correos de MEGI_MEDICOS. Nunca pongas MEGI_USUARIO/MEGI_CONTRASENA aquí.
# OPENAI_BASE_URL=https://api.x.ai/v1   # Grok (xAI)
# OPENAI_API_KEY=
# Motor local con Ollama (alternativa a Grok)
# AGENT_ENGINE=ai-sdk:ollama
# AGENT_MODEL=qwen2.5-14b-32k
# AGENT_MODEL=grok-4.20-0309-non-reasoning # Variante xAI medida para D4.
# OLLAMA_BASE_URL=http://localhost:11434
